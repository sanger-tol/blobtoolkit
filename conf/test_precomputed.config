/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run sanger-tol/blobtoolkit -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '6.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal aligned test dataset to check pipeline function'

    // Aligned reads
    input     = "/nfs/treeoflife-01/teams/tola/users/we3/tpr_btk/btk_samplesheet/samplesheet_GCA_965620485.1.csv"
    align     = true

    // Fasta reference
    fasta     = "/lustre/scratch122/tol/data/e/0/5/6/6/9/Pomatias_elegans/assembly/release/GCA_965620485.1/insdc/GCA_965620485.1.fa.gz"

    // fasta     = "https://tolit.cog.sanger.ac.uk/test-data/Meles_meles/assembly/release/mMelMel3.1_paternal_haplotype/GCA_922984935.2.subset.phiXspike.fasta.gz"

    accession = "GCA_965620485.1"
    taxon     = "928741"

    // Databases
    // taxdump = "https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/new_taxdump/new_taxdump.tar.gz"
    taxdump = "/data/tol/resources/taxonomy/latest/new_taxdump"
    busco   = "/data/tol/resources/busco/latest"
    blastp  = "/data/tol/resources/uniprot_reference_proteomes/latest/reference_proteomes.dmnd"
    blastx  = "/data/tol/resources/uniprot_reference_proteomes/latest/reference_proteomes.dmnd"
    blastn  = "/data/tol/resources/nt/latest"
    lineage_tax_ids = "${projectDir}/assets/mapping_taxids-busco_dataset_name.eukaryota_odb12.2025-01-15.txt"
    precomputed_busco = "${projectDir}/GCA_965620485.1_data/busco_odb12"

    // Need to be set to avoid overfilling /tmp
    use_work_dir_as_temp = true
}
